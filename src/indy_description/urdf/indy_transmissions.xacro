<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:macro name="indy_transmission" params="prefix hw_interface indy_type">

        <xacro:macro name="define_transmission" params="tran joint motor">
            <transmission name="${prefix}${tran}">
                <type>transmission_interface/SimpleTransmission</type>
                <joint name="${prefix}${joint}">
                    <hardwareInterface>${hw_interface}</hardwareInterface>
                </joint>
                <actuator name="${prefix}${motor}">
                    <mechanicalReduction>1</mechanicalReduction>
                </actuator>
            </transmission>
        </xacro:macro>

        <xacro:if value="${indy_type == 'nuri5sdual'}">
            <xacro:define_transmission tran="left_tran0" joint="left_arm_joint0" motor="left_motor0"/>
            <xacro:define_transmission tran="left_tran1" joint="left_arm_joint1" motor="left_motor1"/>
            <xacro:define_transmission tran="left_tran2" joint="left_arm_joint2" motor="left_motor2"/>
            <xacro:define_transmission tran="left_tran3" joint="left_arm_joint3" motor="left_motor3"/>
            <xacro:define_transmission tran="left_tran4" joint="left_arm_joint4" motor="left_motor4"/>
            <xacro:define_transmission tran="left_tran5" joint="left_arm_joint5" motor="left_motor5"/>
            <xacro:define_transmission tran="right_tran0" joint="right_arm_joint0" motor="right_motor0"/>
            <xacro:define_transmission tran="right_tran1" joint="right_arm_joint1" motor="right_motor1"/>
            <xacro:define_transmission tran="right_tran2" joint="right_arm_joint2" motor="right_motor2"/>
            <xacro:define_transmission tran="right_tran3" joint="right_arm_joint3" motor="right_motor3"/>
            <xacro:define_transmission tran="right_tran4" joint="right_arm_joint4" motor="right_motor4"/>
            <xacro:define_transmission tran="right_tran5" joint="right_arm_joint5" motor="right_motor5"/>
        </xacro:if>

        <xacro:unless value="${indy_type == 'dual_icon3' or indy_type == 'nuri5sdual'}">
            <xacro:define_transmission tran="tran0" joint="joint0" motor="motor0"/>
            <xacro:define_transmission tran="tran1" joint="joint1" motor="motor1"/>
            <xacro:define_transmission tran="tran2" joint="joint2" motor="motor2"/>
            <xacro:define_transmission tran="tran3" joint="joint3" motor="motor3"/>
            <xacro:define_transmission tran="tran4" joint="joint4" motor="motor4"/>
            <xacro:define_transmission tran="tran5" joint="joint5" motor="motor5"/>

            <!--indyrp2 with 7 DOF-->
            <xacro:if value="${indy_type == 'indyrp2' or indy_type == 'indyrp2_v2'}">
                <xacro:define_transmission tran="tran6" joint="joint6" motor="motor6"/>
            </xacro:if>
        </xacro:unless>

    </xacro:macro>

</robot>
